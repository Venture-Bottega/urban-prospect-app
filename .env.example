# Copy to .env.local and fill in. Never commit real values.

# Where the app reads its datasets from. Preset to the deployed site so a fresh
# checkout runs without carrying ~390 MB of GeoJSON. Point it at a local
# public/ folder (leave empty, or use "/") if you have the data locally.
VITE_DATA_BASE_URL=https://urban.dotlink.ai/

# Clerk publishable key — public by design, meant to be visible in the browser.
# Get your own free key at https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=
